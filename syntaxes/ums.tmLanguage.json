{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UMS",
  "scopeName": "source.ums",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#declaration" },
    { "include": "#args" },
    { "include": "#call" },
    { "include": "#block" },
    { "include": "#key" },
    { "include": "#constant" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.number-sign.ums", "match": "#.*$" },
        { "name": "comment.line.double-slash.ums", "match": "//.*$" }
      ]
    },
    "string": {
      "name": "string.quoted.double.ums",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.ums", "match": "\\$\\$" },
        { "name": "meta.interpolation.ums", "match": "\\$\\{[^}\"]*\\}" },
        { "name": "constant.character.escape.ums", "match": "\\\\." }
      ]
    },
    "number": { "name": "constant.numeric.integer.ums", "match": "\\b\\d+\\b" },
    "boolean": { "name": "constant.language.boolean.ums", "match": "(?<![\\w.-])(?:true|false)(?![\\w.-])" },
    "declaration": {
      "match": "^\\s*(const|enum)\\s+([A-Za-z_][\\w-]*)",
      "captures": {
        "1": { "name": "storage.type.ums" },
        "2": { "name": "entity.name.constant.ums" }
      }
    },
    "args": { "name": "constant.language.args.ums", "match": "(?<![\\w.-])args(?![\\w.-])" },
    "call": {
      "match": "([A-Za-z_][\\w-]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.ums" } }
    },
    "block": {
      "match": "([A-Za-z_][\\w-]*)(?=\\s*\\{)",
      "captures": { "1": { "name": "keyword.other.block.ums" } }
    },
    "key": {
      "match": "([a-z_][\\w-]*)(?=\\s*=)",
      "captures": { "1": { "name": "variable.other.property.ums" } }
    },
    "constant": {
      "patterns": [
        { "name": "entity.name.constant.ums", "match": "\\b[A-Z][\\w-]*\\.[A-Za-z_][\\w-]*" },
        { "name": "constant.other.ums", "match": "\\b[A-Z][A-Z0-9_]*\\b" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.ums", "match": "," },
        { "name": "keyword.operator.assignment.ums", "match": "=" }
      ]
    }
  }
}
