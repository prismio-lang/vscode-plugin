{
  "name": "prismio",
  "displayName": "Prismio",
  "description": "The Prismio language: diagnostics, completion, navigation and refactoring from the toolchain's own language server.",
  "version": "0.1.0",
  "publisher": "prismio",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prismio-lang/vscode-plugin"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:prismio",
    "onLanguage:ums",
    "workspaceContains:**/build.ums"
  ],
  "contributes": {
    "languages": [
      {
        "id": "prismio",
        "aliases": [
          "Prismio"
        ],
        "extensions": [
          ".psm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/psm.png",
          "dark": "./images/psm.png"
        }
      },
      {
        "id": "ums",
        "aliases": [
          "UMS"
        ],
        "filenames": [
          "build.ums"
        ],
        "extensions": [
          ".ums"
        ],
        "configuration": "./ums-language-configuration.json",
        "icon": {
          "light": "./images/ums.svg",
          "dark": "./images/ums.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "prismio",
        "scopeName": "source.prismio",
        "path": "./syntaxes/prismio.tmLanguage.json"
      },
      {
        "language": "ums",
        "scopeName": "source.ums",
        "path": "./syntaxes/ums.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Prismio",
      "properties": {
        "prismio.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `prismio` executable. Empty means the first one on `PATH`, then `~/.prismio/bin`. The server (`prismio lsp`) and every task come from this toolchain, so its version decides what the editor knows."
        },
        "prismio.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between the editor and the language server to the Prismio output channel."
        }
      }
    },
    "commands": [
      {
        "command": "prismio.restartServer",
        "title": "Prismio: Restart Language Server"
      },
      {
        "command": "prismio.showOutput",
        "title": "Prismio: Show Server Output"
      },
      {
        "command": "prismio.debugTarget",
        "title": "Prismio: Build and Debug a Target"
      },
      {
        "command": "prismio.newProject",
        "title": "Prismio: New Project"
      },
      {
        "command": "prismio.runTarget",
        "title": "Prismio: Run an Executable Target"
      }
    ],
    "taskDefinitions": [
      {
        "type": "prismio",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "build, run, test, clean, or a command declared in build.ums."
          },
          "target": {
            "type": "string",
            "description": "A target of build.ums; every target when empty."
          },
          "release": {
            "type": "boolean",
            "description": "Build with the release profile."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "prismio",
        "owner": "prismio",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)(?:\\[(P?[A-Z]*\\d+)\\])?: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      },
      {
        "name": "prismio-ums",
        "owner": "prismio-ums",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)(?:\\[([A-Z]*\\d+)\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "prismio",
        "scopes": {
          "function": [
            "entity.name.function.prismio"
          ],
          "method": [
            "entity.name.function.prismio"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "prismio",
        "path": "./snippets/prismio.json"
      }
    ],
    "configurationDefaults": {
      "[prismio]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "prismio.prismio"
      }
    }
  },
  "scripts": {
    "grammar": "node scripts/generate-grammar.mjs",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "tsc -p . --noEmit",
    "test:grammar": "node --test test/grammar.test.mjs test/ums-grammar.test.mjs",
    "test:package": "node --test test/package.test.mjs",
    "test:config": "node --test test/language-configuration.test.mjs",
    "test:unit": "node --test test/manifest.test.mjs test/pure.test.mjs test/problem-matcher.test.mjs test/snippets.test.mjs",
    "test": "npm run compile && npm run test:grammar && npm run test:package && npm run test:config && npm run test:unit && node out/test/runTests.js",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0",
    "vscode-textmate": "^9.2.0",
    "vscode-oniguruma": "^2.0.1"
  }
}
