{
  "main": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "}"],
    "description": "Create main function"
  },
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) -> ${3:Int} {", "\t$0", "}"],
    "description": "Create function with return type"
  },
  "fnv": {
    "prefix": "fnv",
    "body": ["fn ${1:name}(${2}) {", "\t$0", "}"],
    "description": "Create void function"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field}: ${3:Int},", "\t$0", "}"],
    "description": "Create struct"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Variant1},", "\t${3:Variant2},", "\t$0", "}"],
    "description": "Create enum"
  },
  "codeset": {
    "prefix": "codeset",
    "body": ["codeset ${1:Name}: ${2:U16} {", "\t${3:Entry1} = ${4:0},", "\t${5:Entry2} = ${6:1},", "\t$0", "}"],
    "description": "Create codeset"
  },
  "impl": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "\tfn ${2:method}() {", "\t\t$0", "\t}", "}"],
    "description": "Create implementation block"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:true}) {", "\t$0", "}"],
    "description": "Create if statement"
  },
  "ife": {
    "prefix": "ife",
    "body": ["if (${1:true}) {", "\t${2}", "} else {", "\t$0", "}"],
    "description": "Create if-else statement"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:true}) {", "\t$0", "}"],
    "description": "Create while loop"
  },
  "for": {
    "prefix": "for",
    "body": ["for (${1:item} in ${2:collection}) {", "\t$0", "}"],
    "description": "Create for loop"
  },
  "forr": {
    "prefix": "forr",
    "body": ["for ${1:i} in ${2:0}..<${3:n} {", "\t$0", "}"],
    "description": "Create range for loop: counts up, or down when the start is past the end"
  },
  "match": {
    "prefix": "match",
    "body": ["match (${1:value}) {", "\t${2:0} => { ${3:result} }", "\t_ => { ${4:default} }", "}"],
    "description": "Create match: the scrutinee is parenthesised and every arm is a block"
  },
  "let": {
    "prefix": "let",
    "body": "let ${1:var} = ${2:0}",
    "description": "Create variable"
  },
  "letm": {
    "prefix": "letm",
    "body": "let mut ${1:var} = ${2:0}",
    "description": "Create mutable variable"
  },
  "pln": {
    "prefix": "pln",
    "body": "println(${1})",
    "description": "Print line"
  },
  "extern": {
    "prefix": "extern",
    "body": "extern fn ${1:name}(${2}) -> ${3:Int}",
    "description": "External function declaration"
  }
}
